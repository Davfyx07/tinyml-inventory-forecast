# Copiar como servicio/.env y completar. servicio/.env no se sube a GitHub.
# Son los mismos datos de MQTT que firmware/include/secrets.h: el servicio y el ESP32 se conectan al mismo Mosquitto.
# IP de Home Assistant (donde corre Mosquitto): Configuración → Sistema → Red
MQTT_HOST=192.168.x.x
# Puerto estándar de MQTT; Mosquitto usa 1883 salvo que se haya cambiado en su configuración
MQTT_PUERTO=1883
MQTT_USER=esp32
MQTT_PASS=clave_mqtt
# Ruta de la base de datos (por defecto servicio/inventario.db)
# BD=servicio/inventario.db
